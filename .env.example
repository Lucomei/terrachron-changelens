# Optional HTTP receiver. Must accept multipart/form-data and allow this site's origin.
VITE_TRANSFER_URL=

# Optional local Qwen/model REST API base. This is an address, not a secret.
# Example: http://127.0.0.1:8000/api/v1
VITE_MODEL_API_BASE=

# Agnes API Key 是服务端密钥：仅在 Vercel Environment Variables 设置 AGNES_API_KEY。

